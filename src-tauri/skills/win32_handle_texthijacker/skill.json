{
  "name": "win32_handle_texthijacker",
  "description": "WorkBuddy 专属句柄数据粘合器。绕过鼠标模拟与全屏截图，直接通过 Windows Win32 API 句柄控制树提取或注入活动窗口的底层文本，实现跨应用零延迟无感数据对齐。",
  "version": "2.0.0",
  "author": "Chronos-Shadow Team",
  "type": "builtin",
  "category": "workbuddy",
  "tags": ["Win32", "句柄注入", "WM_SETTEXT", "零延迟", "跨应用"],
  "executor": "native",
  "script_path": "skills/win32_handle_texthijacker/run.ps1",
  "timeout_secs": 10,
  "parameters": {
    "type": "object",
    "properties": {
      "source_window_keyword": {
        "type": "string",
        "description": "源软件窗体标题模糊匹配关键字，如 '旧版财务系统'"
      },
      "target_window_keyword": {
        "type": "string",
        "description": "目标软件窗体标题模糊匹配关键字，如 'Chrome'"
      },
      "extraction_schema": {
        "type": "object",
        "description": "定义需要提取的控件类名（ClassName）与对应的黑板数据映射关系",
        "properties": {
          "control_class": { "type": "string", "description": "例如 'Edit' 或 'Static'" },
          "blackboard_key": { "type": "string" }
        }
      }
    },
    "required": ["source_window_keyword", "target_window_keyword", "extraction_schema"]
  },
  "benefits": {
    "speed_boost": "300%",
    "token_reduction": "千分之一",
    "method": "FindWindowExW + SendMessageW 句柄直写"
  }
}
