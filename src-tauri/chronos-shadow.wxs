<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product
    Id="*"
    Name="Chronos-Shadow"
    Language="2052"
    Version="0.1.0"
    Manufacturer="Chronos-Shadow Team"
    UpgradeCode="C5D7F8A9-1234-5678-9ABC-DEF012345678">

    <Package InstallerVersion="200" Compressed="yes" InstallScope="perMachine" Platform="x64" />

    <Media Id="1" Cabinet="media1.cab" EmbedCab="yes" />
    <MajorUpgrade DowngradeErrorMessage="A newer version is already installed." />

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="APPLICATIONFOLDER" Name="Chronos-Shadow">
          <Component Id="MainEXE" Guid="A1B2C3D4-1111-2222-3333-444455556666">
            <File Id="chronos_shadow_exe" Name="chronos-shadow.exe" Source="target\release\chronos-shadow.exe" KeyPath="yes" />
          </Component>
          <Component Id="Resources" Guid="A1B2C3D4-3333-4444-5555-666677778888">
            <File Id="splash_png" Name="splash.png" Source="..\dist\splash.png" />
          </Component>
        </Directory>
      </Directory>
      <Directory Id="ProgramMenuFolder">
        <Directory Id="ApplicationProgramsFolder" Name="Chronos-Shadow" />
      </Directory>
      <Directory Id="DesktopFolder" />
    </Directory>

    <Feature Id="MainFeature" Title="Chronos-Shadow" Level="1">
      <ComponentRef Id="MainEXE" />
      <ComponentRef Id="Resources" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="DesktopShortcut" />
    </Feature>

    <DirectoryRef Id="ApplicationProgramsFolder">
      <Component Id="StartMenuShortcut" Guid="B1C2D3E4-4444-5555-6666-777788889999">
        <Shortcut Id="StartMenuShortcut" Name="Chronos-Shadow" Target="[APPLICATIONFOLDER]chronos-shadow.exe" WorkingDirectory="APPLICATIONFOLDER" />
        <RemoveFolder Id="RemoveProgramsFolder" Directory="ApplicationProgramsFolder" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\Chronos-Shadow" Name="installed" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <DirectoryRef Id="DesktopFolder">
      <Component Id="DesktopShortcut" Guid="C1D2E3F4-5555-6666-7777-888899990000">
        <Shortcut Id="DesktopShortcut" Name="Chronos-Shadow.lnk" Target="[APPLICATIONFOLDER]chronos-shadow.exe" WorkingDirectory="APPLICATIONFOLDER" />
        <RegistryValue Root="HKCU" Key="Software\Chronos-Shadow" Name="desktopShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </DirectoryRef>

  </Product>
</Wix>
